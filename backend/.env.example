# Copy to backend/.env (the file must exist: BackendApplication calls Dotenv.load()).
# Every entry is copied into a JVM system property, so Spring property names used
# here override the same keys in src/main/resources/application.properties.
# Never commit backend/.env.

spring.datasource.url=jdbc:mysql://localhost:3306/medical_diagnosis
spring.datasource.username=your-mysql-user
spring.datasource.password=your-mysql-password

spring.data.mongodb.uri=mongodb://localhost:27017/sids

# Google Gemini API key used by the chatbot service
gemini.api.key=your-gemini-api-key

# HS256 signing key: at least 32 random bytes
jwt.signerKey=your-long-random-secret-here
jwt.valid-duration=86400
jwt.refreshable-duration=604800
